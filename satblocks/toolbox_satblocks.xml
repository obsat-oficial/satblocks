  <category name="⏱️ Temporização &amp; Relógio" colour="#7c3aed">
    <block type="sat_wait"><field name="TIME">1</field><field name="UNIT">SEC</field></block>
    <block type="sat_time_sleep_ms"><value name="MS"><shadow type="math_number"><field name="NUM">500</field></shadow></value></block>
    <block type="sat_time_sleep_us"><value name="US"><shadow type="math_number"><field name="NUM">100</field></shadow></value></block>
    <block type="sat_time_ticks_ms"></block>
    <block type="sat_time_ticks_us"></block>
    <block type="sat_time_ticks_diff"></block>
    <block type="sat_time_localtime"></block>
  </category>

  <category name="🐍 Python &amp; Avançado" colour="#3776ab">
    <block type="try_catch"></block>
    <block type="exec_python">
      <value name="command">
        <shadow type="text">
          <field name="TEXT">print("SatBlocks OBSAT")</field>
        </shadow>
      </value>
    </block>
    <block type="exec_python_output">
      <value name="command">
        <shadow type="text">
          <field name="TEXT">time.ticks_ms()</field>
        </shadow>
      </value>
    </block>
    <block type="inter_init">
      <value name="Nome">
        <shadow type="text">
          <field name="TEXT">botao_ejeção</field>
        </shadow>
      </value>
      <value name="Função">
        <shadow type="text">
          <field name="TEXT">ao_pressionar</field>
        </shadow>
      </value>
      <value name="pin">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
    </block>
